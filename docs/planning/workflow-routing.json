  "validation": {
    "metadata": [
      "python3 scripts/validate_plan.py",
      "python3 scripts/next_chunk.py --validate",
      "git diff --check"
    ],
    "python": [
      "uv run ruff check {python_paths}",
      "uv run ruff format --check {python_paths}",
      "uv run mypy {python_paths}",
      "uv run pytest tests/chunks/{chunk_id}"
    ],
    "web": [
      "pnpm exec eslint {web_paths}",
      "pnpm exec tsc --noEmit -p {owning_tsconfig}",
      "pnpm exec vitest run tests/chunks/{chunk_id}",
      "pnpm --dir apps/web exec next build"
    ],
    "integration": [
      "uv run pytest tests/chunks/{chunk_id} -m integration"
    ],
    "operations": [
      "docker compose -f {changed_compose_file} config --quiet",
      "uv run pytest tests/chunks/{chunk_id}"
    ],
    "acceptance": [
      "uv run pytest tests/chunks/{chunk_id}",
      "pnpm exec playwright test tests/chunks/{chunk_id}"
    ],
    "migration": [
      "uv run alembic upgrade head",
      "uv run pytest tests/chunks/{chunk_id} -m migration"
    ]
  },
  "risk": {
    "low": {
      "depth": "lightweight",
      "independent": false,
      "model": "gpt-5.6-luna",
      "reasoning": "low",
      "context_budget_tokens": 6000,
      "why": "Bounded established-pattern work; deterministic checks and local diff review suffice."
    },
    "medium": {
      "depth": "focused",
      "independent": false,
      "model": "gpt-5.6-terra",
      "reasoning": "medium",
      "context_budget_tokens": 12000,
      "why": "Established architecture with normal implementation and focused contract review."
    },
    "high": {
      "depth": "deep",
      "independent": true,
      "model": "gpt-6-astra",
      "reasoning": "high",
      "context_budget_tokens": 18000,
      "why": "Sensitive data, authorization or transactional boundaries need independent deep review."
    },
    "critical": {
      "depth": "deep",
      "independent": true,
      "model": "gpt-6-astra",
      "reasoning": "xhigh",
      "context_budget_tokens": 24000,
      "why": "Critical security or migration/recovery safety needs the strongest targeted review."
    }
  },
  "expansion_reasons": [
    "contract_ambiguity",
