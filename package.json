{
  "name": "zuno-edu-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "lint": "eslint apps/web/src packages/contracts/src tests/chunks/**/*.test.tsx vitest.config.ts eslint.config.mjs",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p packages/contracts/tsconfig.json && tsc --noEmit -p tests/chunks/ZE-P01-C01/tsconfig.json && tsc --noEmit -p tests/chunks/ZE-P01-C03/tsconfig.json",
    "test": "vitest run",
    "contracts:check": "uv run --locked python scripts/generate_contracts.py --check",
    "contracts:generate": "uv run --locked python scripts/generate_contracts.py"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "openapi-typescript": "7.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
